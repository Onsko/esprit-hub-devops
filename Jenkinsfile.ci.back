pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    environment {
        SONAR_HOST_URL = 'http://host.docker.internal:9000'
        SONAR_LOGIN = credentials('sonarqube-token')
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                echo "🔄 CI-Back: Checkout du repository..."
                deleteDir()
                git branch: 'main', url: 'https://github.com/Onsko/esprit-hub-devops.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo "📦 Installation des dépendances backend..."
                dir('backend') {
                    script {
                        if (isUnix()) {
                            sh 'npm ci || npm install'
                        } else {
                            bat 'npm ci || npm install'
                        }
                    }
                }
            }
        }

        stage('Run Unit Tests') {
            steps {
                echo "🧪 Exécution des tests unitaires backend..."
                dir('backend') {
                    script {
                        if (isUnix()) {
                            sh 'npm run test:ci'
                        } else {
                            bat 'npm run test:ci'
                        }
                    }
                }
            }
        }

        stage('Generate Coverage Report') {
            steps {
                echo "📊 Génération du rapport de couverture..."
                dir('backend') {
                    script {
                        if (isUnix()) {
                            sh 'ls -la coverage/ || echo "Coverage directory not found"'
                        } else {
                            bat 'dir coverage || echo Coverage directory not found'
                        }
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "🔍 Analyse SonarQube du backend..."
                dir('backend') {
                    script {
                        def scannerHome = tool 'SonarScanner'
                        withSonarQubeEnv('SonarQubeServer') {
                            if (isUnix()) {
                                sh "\"${scannerHome}/bin/sonar-scanner\" -Dsonar.projectKey=skillup-backend -Dsonar.sources=src -Dsonar.tests=src -Dsonar.test.inclusions=**/*.spec.ts,**/*.test.ts -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info -Dsonar.host.url=${SONAR_HOST_URL}"
                            } else {
                                bat "\"${scannerHome}\\bin\\sonar-scanner.bat\" -Dsonar.projectKey=skillup-backend -Dsonar.sources=src -Dsonar.tests=src -Dsonar.test.inclusions=**/*.spec.ts,**/*.test.ts -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info -Dsonar.host.url=${SONAR_HOST_URL}"
                            }
                        }
                    }
                }
            }
        }

        stage('Build') {
            steps {
                echo "🏗️ Build du backend..."
                dir('backend') {
                    script {
                        if (isUnix()) {
                            sh 'npm run build'
                        } else {
                            bat 'npm run build'
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo "📁 Archivage des artefacts..."
            archiveArtifacts artifacts: 'backend/coverage/**,backend/dist/**', allowEmptyArchive: true
            junit testResults: 'backend/coverage/**/*.xml', allowEmptyResults: true
        }
        success {
            echo "✅ CI-Back: Tests et analyse réussis!"
        }
        failure {
            echo "❌ CI-Back: Échec du pipeline"
        }
    }
}

